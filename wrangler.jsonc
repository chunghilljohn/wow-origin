{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wow-origin",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NODE_ENV": "production",
    "CF_LX_SOURCE_URL": "https://raw.githubusercontent.com/Manngok/Jstore/main/Chang.js"
  },
  "build": {
    "command": "npm run cloudflare:prepare"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ORIGIN",
        "class_name": "OriginDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OriginDurableObject"]
    }
  ],
  "triggers": {
    "crons": ["0 17 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
